{
  "manifest_version": 3,
  "name": "Peeko \u2014 20\u00b720\u00b720",
  "version": "1.5.2",
  "description": "A little distance. A clearer day. Eye-break reminders with personal themes and a playful companion.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Peeko",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "font-data.js",
        "fonts.js",
        "pets.js",
        "themes.js",
        "ui.js",
        "positioning.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
